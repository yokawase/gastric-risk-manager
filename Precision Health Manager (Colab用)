{"cells":[{"cell_type":"code","source":["# ==============================================================================\n","# Precision Health Manager: Gastric DX Edition (Google Colab実装)\n","# 組織型検診プラットフォームのバックエンド・アルゴリズムと可視化ロジック\n","# ==============================================================================\n","\n","# 【実行前の準備】\n","# 以下の行のコメントアウト（#）を外し、Colabの最初のセルで実行して必要なライブラリをインストールしてください。\n","!pip install japanize-matplotlib lifelines scikit-learn\n","\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import japanize_matplotlib\n","from lifelines import KaplanMeierFitter\n","from sklearn.linear_model import LogisticRegression\n","from sklearn.preprocessing import StandardScaler\n","from IPython.display import display, HTML\n","\n","# ==============================================================================\n","# 1. PMH/マイナポータル連携を想定した仮想健康データの生成 (N=15,000)\n","# ==============================================================================\n","np.random.seed(42)\n","n_users = 15000\n","\n","df = pd.DataFrame({\n","    'user_id': range(1, n_users + 1),\n","    'age': np.random.randint(25, 65, n_users),          # 25〜64歳\n","    'sex': np.random.choice(['M', 'F'], n_users),\n","    'bmi': np.random.normal(23, 3.5, n_users),\n","    'smoking': np.random.choice([0, 1], n_users, p=[0.7, 0.3]),\n","    'family_history': np.random.choice([0, 1], n_users, p=[0.9, 0.1]),\n","    'hp_eradicated': np.random.choice([0, 1], n_users, p=[0.6, 0.4]), # ピロリ除菌歴\n","    'pepsinogen_abnormal': np.random.choice([0, 1], n_users, p=[0.8, 0.2]) # 萎縮\n","})\n","\n","# 要精検（一次検査で異常あり）フラグの生成\n","prob_req_sec = (\n","    (df['age'] > 50) * 0.05 +\n","    df['hp_eradicated'] * 0.1 +\n","    df['pepsinogen_abnormal'] * 0.3\n",").clip(0.01, 0.9)\n","df['requires_secondary'] = np.random.binomial(1, prob_req_sec)\n","\n","# 精検受診行動（生存時間解析用データ）のシミュレーション\n","df['secondary_done'] = 0\n","df['days_to_secondary'] = np.nan\n","\n","mask_req = df['requires_secondary'] == 1\n","# 除菌済みの人ほど「自分は大丈夫」と過信し、受診率が下がるよう設定\n","prob_done = 0.85 - (df.loc[mask_req, 'hp_eradicated'] == 1) * 0.3\n","df.loc[mask_req, 'secondary_done'] = np.random.binomial(1, prob_done.clip(0.1, 0.95))\n","\n","mask_done = df['secondary_done'] == 1\n","# 除菌済みの人は受診までのリードタイムも長くなる傾向\n","base_days = np.random.exponential(30, mask_done.sum())\n","df.loc[mask_done, 'days_to_secondary'] = np.clip(\n","    base_days + (df.loc[mask_done, 'hp_eradicated'] == 1) * 45,\n","    5, 365\n",")\n","\n","# 未受診者（打ち切りデータ）の経過日数\n","mask_not_done = (df['requires_secondary'] == 1) & (df['secondary_done'] == 0)\n","df.loc[mask_not_done, 'days_to_secondary'] = np.random.randint(60, 365, mask_not_done.sum())\n","\n","\n","# ==============================================================================\n","# 2. AIリスク層別化エンジンの構築（ロジスティック回帰）\n","# ==============================================================================\n","features = ['age', 'bmi', 'smoking', 'family_history', 'hp_eradicated', 'pepsinogen_abnormal']\n","X = df[features]\n","y = np.random.binomial(1, prob_req_sec * 0.6) # 真のリスク（仮想）\n","\n","scaler = StandardScaler()\n","X_scaled = scaler.fit_transform(X)\n","model = LogisticRegression(class_weight='balanced')\n","model.fit(X_scaled, y)\n","\n","# 0〜100のスコアに変換\n","df['risk_score'] = model.predict_proba(X_scaled)[:, 1] * 100\n","\n","# リスクレベルの判定（高: 上位12%, 中: 38%, 低: 50%に近づくよう閾値設定）\n","df['risk_level'] = pd.cut(\n","    df['risk_score'],\n","    bins=[-1, 40, 75, 100],\n","    labels=['低リスク', '中リスク', '高リスク']\n",")\n","\n","\n","# ==============================================================================\n","# 3. 管理者向けB2Bダッシュボード（KPI計算とMatplotlibによる可視化）\n","# ==============================================================================\n","def display_admin_dashboard():\n","    print(\"\\n\" + \"=\"*80)\n","    print(\" 🏢 組織型検診 精度管理ダッシュボード (B2B SaaS ビュー)\")\n","    print(\"=\"*80)\n","\n","    # --- KPI計算 ---\n","    target_50plus = len(df[df['age'] >= 50])\n","    req_sec_count = df['requires_secondary'].sum()\n","    sec_done_count = df['secondary_done'].sum()\n","\n","    req_sec_rate = (req_sec_count / len(df)) * 100\n","    sec_done_rate = (sec_done_count / req_sec_count) * 100\n","\n","    print(f\"\\n[重要プロセス指標 (KPI)]\")\n","    print(f\"▶ 対象者数 (50歳以上) : {target_50plus:,} 人\")\n","    print(f\"▶ 要精検者数          : {req_sec_count:,} 人 (要精検率: {req_sec_rate:.1f}%)\")\n","\n","    if sec_done_rate < 90:\n","        print(f\"▶ 精検受診率          : {sec_done_rate:.1f}% ⚠️ (国の目標90%未達。介入が必要です)\")\n","    else:\n","        print(f\"▶ 精検受診率          : {sec_done_rate:.1f}% ✅ (目標達成)\")\n","\n","    # --- グラフ描画 (リスク分布 & カプランマイヤー) ---\n","    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 6))\n","    fig.patch.set_facecolor('#f8fafc')\n","\n","    # グラフ1: AIリスク層別化 分布 (Doughnut Chart)\n","    risk_counts = df['risk_level'].value_counts()\n","    colors = ['#10b981', '#f59e0b', '#f43f5e'] # 緑(低), 黄(中), 赤(高)\n","    wedges, texts, autotexts = ax1.pie(\n","        [risk_counts['低リスク'], risk_counts['中リスク'], risk_counts['高リスク']],\n","        labels=['低リスク\\n(対策型待機)', '中リスク\\n(ABC検診推奨)', '高リスク\\n(即時内視鏡)'],\n","        autopct='%1.1f%%', startangle=90, colors=colors,\n","        wedgeprops=dict(width=0.4, edgecolor='w')\n","    )\n","    plt.setp(autotexts, size=11, weight=\"bold\", color=\"white\")\n","    ax1.set_title(\"AIリスク層別化 分布\", fontsize=14, fontweight='bold', color='#1e293b')\n","\n","    # グラフ2: カプラン・マイヤー生存時間解析 (未受診率の推移)\n","    kmf = KaplanMeierFitter()\n","    T = df[df['requires_secondary'] == 1]['days_to_secondary']\n","    E = df[df['requires_secondary'] == 1]['secondary_done']\n","    groups = df[df['requires_secondary'] == 1]['hp_eradicated']\n","\n","    # ピロリ除菌歴「なし」\n","    idx_no_hp = (groups == 0)\n","    kmf.fit(T[idx_no_hp], event_observed=E[idx_no_hp], label='除菌歴なし (未感染含む)')\n","    kmf.plot_survival_function(ax=ax2, color='#3b82f6', linewidth=2) # blue\n","\n","    # ピロリ除菌歴「あり」\n","    idx_hp = (groups == 1)\n","    kmf.fit(T[idx_hp], event_observed=E[idx_hp], label='ピロリ除菌歴あり (過信・高ドロップアウト)')\n","    kmf.plot_survival_function(ax=ax2, color='#f43f5e', linewidth=2, linestyle='--') # rose\n","\n","    ax2.set_title(\"要精検判定後の未受診率推移 (生存時間解析)\", fontsize=14, fontweight='bold', color='#1e293b')\n","    ax2.set_xlabel('要精検判定からの経過日数', fontsize=12)\n","    ax2.set_ylabel('未受診率 (1.0 = 全員未受診)', fontsize=12)\n","    ax2.set_ylim(0, 1.05)\n","    ax2.axhline(y=0.1, color='#10b981', linestyle=':', linewidth=2, label='国目標 (未受診10%以下)')\n","    ax2.grid(True, linestyle='--', alpha=0.5)\n","    ax2.legend(loc='lower left')\n","\n","    plt.tight_layout()\n","    plt.show()\n","\n","    print(\"\\n💡 [インサイト] 赤の破線（除菌歴あり）は、判定後30日以降で受診行動が著しく低下しています。\")\n","    print(\"   この層に対し、30日時点で「除菌後も胃がんリスクは残る」というナッジを自動配信すべきです。\")\n","\n","\n","# ==============================================================================\n","# 4. 個人向けアプリ画面 (B2B2C Nudge UI) - HTML/CSSで描画\n","# ==============================================================================\n","def display_patient_app(user_idx=None):\n","    if user_idx is None:\n","        # デモ用：高リスクで除菌歴あり、かつ要精検の若年者を探す\n","        target = df[(df['risk_level'] == '高リスク') & (df['hp_eradicated'] == 1) & (df['age'] < 50) & (df['requires_secondary'] == 1)].iloc[0]\n","    else:\n","        target = df.iloc[user_idx]\n","\n","    score = target['risk_score']\n","\n","    # 行動経済学に基づくナッジメッセージ生成\n","    html_content = f\"\"\"\n","    <div style=\"font-family: 'Noto Sans JP', sans-serif; background-color: #f8fafc; padding: 20px; display: flex; justify-content: center;\">\n","        <div style=\"background: white; width: 380px; border-radius: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1); overflow: hidden; border: 6px solid #cbd5e1;\">\n","\n","            <!-- App Header -->\n","            <div style=\"background-color: #4f46e5; color: white; padding: 30px 20px 15px 20px;\">\n","                <div style=\"font-size: 14px; opacity: 0.9;\">こんにちは、</div>\n","                <div style=\"font-size: 22px; font-weight: bold;\">テストユーザー 様 ({int(target['age'])}歳)</div>\n","            </div>\n","\n","            <!-- App Body -->\n","            <div style=\"padding: 20px;\">\n","\n","                <!-- Alert -->\n","                <div style=\"background-color: #fff1f2; border-left: 4px solid #f43f5e; padding: 12px; border-radius: 0 8px 8px 0; margin-bottom: 20px;\">\n","                    <strong style=\"color: #9f1239; font-size: 14px;\">⚠️ 重要なお知らせ</strong>\n","                    <div style=\"color: #be123c; font-size: 12px; margin-top: 4px;\">前回の健診結果から、精密検査（胃内視鏡）の受診が強く推奨されています。</div>\n","                </div>\n","\n","                <!-- Risk Meter -->\n","                <div style=\"border: 1px solid #e2e8f0; border-radius: 12px; padding: 15px; text-align: center; margin-bottom: 20px;\">\n","                    <div style=\"font-size: 13px; font-weight: bold; color: #334155;\">現在のあなたの胃がんAIリスクスコア</div>\n","                    <div style=\"font-size: 42px; font-weight: 900; color: #f43f5e; margin: 10px 0;\">{score:.0f}<span style=\"font-size: 16px; color: #94a3b8;\">/100</span></div>\n","                    <div style=\"font-size: 12px; color: #64748b; background: #f1f5f9; display: inline-block; padding: 4px 10px; border-radius: 20px;\">\n","                        同年代の<span style=\"color: #f43f5e; font-weight: bold;\">上位12% (高リスク)</span>に相当\n","                    </div>\n","                </div>\n","\n","                <!-- Educational Nudge -->\n","                <div style=\"background-color: #f8fafc; border-radius: 12px; padding: 15px; margin-bottom: 20px;\">\n","                    <div style=\"font-size: 13px; font-weight: bold; color: #1e293b; margin-bottom: 8px;\">👨‍⚕️ AIドクターからのメッセージ</div>\n","                    <div style=\"font-size: 12px; color: #475569; line-height: 1.5;\">\n","                        数年前に<span style=\"color: #4f46e5; font-weight: bold;\">ピロリ菌の除菌</span>を完了されていますが、胃粘膜の萎縮は残っており、<b>胃がんが発生するリスクはゼロになっていません。</b><br><br>\n","                        <span style=\"background: #e0e7ff; color: #3730a3; padding: 2px 4px; border-radius: 4px;\">💡 統計上、あなたと同じリスク層の 82% が、通知後1ヶ月以内に内視鏡を予約しています。</span>\n","                    </div>\n","                </div>\n","\n","                <!-- Commitment Action -->\n","                <div style=\"border: 2px solid #c7d2fe; border-radius: 12px; padding: 15px;\">\n","                    <div style=\"font-size: 13px; font-weight: bold; color: #1e293b; margin-bottom: 12px;\">✅ あなたのアクションプラン</div>\n","                    <label style=\"display: flex; align-items: flex-start; margin-bottom: 15px; cursor: pointer;\">\n","                        <input type=\"checkbox\" style=\"margin-top: 3px; transform: scale(1.2); accent-color: #4f46e5;\">\n","                        <div style=\"font-size: 13px; color: #334155; margin-left: 10px;\">\n","                            提携クリニックでの胃内視鏡検査を予約する\n","                            <div style=\"color: #f43f5e; font-size: 11px; margin-top: 2px;\">※企業補助により自己負担0円で受診可能です</div>\n","                        </div>\n","                    </label>\n","                    <button style=\"background-color: #4f46e5; color: white; width: 100%; border: none; padding: 12px; border-radius: 8px; font-weight: bold; font-size: 14px; cursor: pointer; box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.3);\">\n","                        優先枠でWEB予約する\n","                    </button>\n","                </div>\n","\n","            </div>\n","        </div>\n","    </div>\n","    \"\"\"\n","\n","    print(\"\\n\" + \"=\"*80)\n","    print(\" 📱 個人向け健康管理アプリ (B2B2C ナッジUI ビュー)\")\n","    print(\"=\"*80)\n","    display(HTML(html_content))\n","\n","\n","# ==============================================================================\n","# メイン実行ブロック\n","# ==============================================================================\n","if __name__ == \"__main__\":\n","    # 1. B2B ダッシュボードの表示\n","    display_admin_dashboard()\n","\n","    # 2. B2B2C 個人向けアプリ画面の表示\n","    display_patient_app()"],"outputs":[{"output_type":"stream","name":"stdout","text":["Collecting japanize-matplotlib\n","  Downloading japanize-matplotlib-1.1.3.tar.gz (4.1 MB)\n","\u001b[2K     \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m4.1/4.1 MB\u001b[0m \u001b[31m74.9 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[?25h  Preparing metadata (setup.py) ... \u001b[?25l\u001b[?25hdone\n","Collecting lifelines\n","  Downloading lifelines-0.30.1-py3-none-any.whl.metadata (3.4 kB)\n","Requirement already satisfied: scikit-learn in /usr/local/lib/python3.12/dist-packages (1.6.1)\n","Requirement already satisfied: matplotlib in /usr/local/lib/python3.12/dist-packages (from japanize-matplotlib) (3.10.0)\n","Requirement already satisfied: numpy>=1.14.0 in /usr/local/lib/python3.12/dist-packages (from lifelines) (2.0.2)\n","Requirement already satisfied: scipy>=1.7.0 in /usr/local/lib/python3.12/dist-packages (from lifelines) (1.16.3)\n","Requirement already satisfied: pandas<3.0,>=2.1 in /usr/local/lib/python3.12/dist-packages (from lifelines) (2.2.2)\n","Requirement already satisfied: autograd>=1.5 in /usr/local/lib/python3.12/dist-packages (from lifelines) (1.8.0)\n","Collecting autograd-gamma>=0.3 (from lifelines)\n","  Downloading autograd-gamma-0.5.0.tar.gz (4.0 kB)\n","  Preparing metadata (setup.py) ... \u001b[?25l\u001b[?25hdone\n","Collecting formulaic>=0.2.2 (from lifelines)\n","  Downloading formulaic-1.2.1-py3-none-any.whl.metadata (7.0 kB)\n","Requirement already satisfied: joblib>=1.2.0 in /usr/local/lib/python3.12/dist-packages (from scikit-learn) (1.5.3)\n","Requirement already satisfied: threadpoolctl>=3.1.0 in /usr/local/lib/python3.12/dist-packages (from scikit-learn) (3.6.0)\n","Collecting interface-meta>=1.2.0 (from formulaic>=0.2.2->lifelines)\n","  Downloading interface_meta-1.3.0-py3-none-any.whl.metadata (6.7 kB)\n","Requirement already satisfied: narwhals>=1.17 in /usr/lo