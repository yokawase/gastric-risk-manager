=========================\n","# 次世代胃がん検診DX SaaSプロトタイプ実装 (Google Colab環境用)\n","# ロードマップ Step 1 〜 Step 4 のコアアルゴリズムと可視化ロジック\n","# ==============================================================================\n","\n","# 事前準備: Colabで日本語をプロットで表示し、生存時間解析を行うためのライブラリをインストールします。\n","# Colabの最初のセルで以下を実行してください。\n","# !pip install japanize-matplotlib lifelines scikit-learn\n","\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import japanize_matplotlib  # 日本語フォント対応\n","from lifelines import KaplanMeierFitter\n","from sklearn.linear_model import LogisticRegression\n","from sklearn.preprocessing import StandardScaler\n","from IPython.display import display, HTML\n","\n","# ==============================================================================\n","# Step 1: 要件定義とデータ連携基盤の確立（仮想データの生成）\n","# ==============================================================================\n","# 本来はPMHやマイナポータルからFHIR規格で連携されるデータを想定。\n","# ここでは10,000人分の職域（企業）仮想データを生成します。\n","\n","np.random.seed(42)\n","n_users = 10000\n","\n","# ユーザー基本データ\n","df = pd.DataFrame({\n","    'user_id': range(1, n_users + 1),\n","    'age': np.random.randint(25, 65, n_users),          # 25〜64歳\n","    'sex': np.random.choice(['M', 'F'], n_users),\n","    'bmi': np.random.normal(23, 3, n_users),\n","    'smoking': np.random.choice([0, 1], n_users, p=[0.7, 0.3]), # 喫煙歴\n","    'family_history': np.random.choice([0, 1], n_users, p=[0.9, 0.1]), # 家族歴\n","    'hp_eradicated': np.random.choice([0, 1], n_users, p=[0.6, 0.4]), # ピロリ除菌歴(40%が除菌済)\n","    'pepsinogen_abnormal': np.random.choice([0, 1], n_users, p=[0.8, 0.2]) # ペプシノゲン異常(萎縮)\n","})\n","\n","# 精密検査（内視鏡）のフラグシミュレーション\n","# リスクが高い人ほど「要精検（一次検査で陽性・異常）」になりやすいよう重み付け\n","prob_requires_secondary = (\n","    (df['age'] > 50) * 0.1 +\n","    df['hp_eradicated'] * 0.15 +\n","    df['pepsinogen_abnormal'] * 0.3\n",").clip(0.05, 0.9) # 確率を5%〜90%にクリップ\n","\n","df['requires_secondary'] = np.random.binomial(1, prob_requires_secondary)\n","\n","# 精検受診行動のシミュレーション（生存時間解析用データ）\n","# 若年層や除菌済みの人は「自分は大丈夫」と過信し、受診が遅れる（または未受診になる）傾向をシミュレート\n","df['secondary_done'] = 0\n","df['days_to_secondary'] = np.nan\n","\n","mask_req = df['requires_secondary'] == 1\n","n_req = mask_req.sum()\n","\n","# 精検対象者のうち、実際に受診する確率（ベース60%）\n","prob_done = 0.6 - (df.loc[mask_req, 'age'] < 50) * 0.1 - (df.loc[mask_req, 'hp_eradicated'] == 1) * 0.15\n","df.loc[mask_req, 'secondary_done'] = np.random.binomial(1, prob_done.clip(0.1, 0.9))\n","\n","# 受診した人の「要精検判定から受診までの日数（リードタイム）」\n","mask_done = df['secondary_done'] == 1\n","# 年齢が高いほど早く行く、除菌済は遅れがち\n","base_days = np.random.exponential(45, mask_done.sum())\n","df.loc[mask_done, 'days_to_secondary'] = np.clip(\n","    base_days + (df.loc[mask_done, 'hp_eradicated'] == 1) * 30,\n","    5, 365 # 5日〜最長1年\n",")\n","\n","# 受診していない人（打ち切りデータ）の日数は、現在までの経過日数（ランダムに30〜365日）とする\n","mask_not_done = (df['requires_secondary'] == 1) & (df['secondary_done'] == 0)\n","df.loc[mask_not_done, 'days_to_secondary'] = np.random.randint(30, 365, mask_not_done.sum())\n","\n","\n","# ==============================================================================\n","# Step 2: リスク層別化アルゴリズムの実装（ロジスティック回帰モデル）\n","# ==============================================================================\n","# 50歳以下の若年層に対し、内視鏡サーベイランスの優先度を決定するスコアリングエンジン\n","\n","features = ['age', 'bmi', 'smoking', 'family_history', 'hp_eradicated', 'pepsinogen_abnormal']\n","X = df[features]\n","# 目的変数：仮想的に「3年以内の高リスク（ポリープ・早期がん発見など）」を設定\n","y = np.random.binomial(1, prob_requires_secondary * 0.5)\n","\n","scaler = StandardScaler()\n","X_scaled = scaler.fit_transform(X)\n","\n","model = LogisticRegression(class_weight='balanced')\n","model.fit(X_scaled, y)\n","\n","# 全ユーザーにリスクスコア（0〜100）を付与\n","df['risk_score'] = model.predict_proba(X_scaled)[:, 1] * 100\n","\n","\n","# ==============================================================================\n","# Step 3: 行動変容を促すアプリ画面（フロントエンドUI/UXシミュレーション）\n","# ==============================================================================\n","def display_patient_app(user_id):\n","    \"\"\"個人のスマートフォンアプリ（SaaSフロントエンド）に表示されるナッジUIをシミュレート\"\"\"\n","    user = df[df['user_id'] == user_id].iloc[0]\n","\n","    # リスクスコアによる分岐\n","    if user['risk_score'] >= 70:\n","        risk_level = \"<span style='color:red; font-weight:bold;'>【高リスク】</span>\"\n","        recommendation = \"ピロリ菌除菌後も胃がんリスクは残存しています。今年は<b>胃内視鏡検査（胃カメラ）</b>を強く推奨します。\"\n","        todo = \"提携クリニックでの内視鏡予約（優先枠あり）\"\n","    elif user['risk_score'] >= 40:\n","        risk_level = \"<span style='color:orange; font-weight:bold;'>【中リスク】</span>\"\n","        recommendation = \"定期的なモニタリングが必要です。今年はABC検診（血液検査）または胃部X線検査を受診してください。\"\n","        todo = \"社内健診のオプション追加（ABC検診）\"\n","    else:\n","        risk_level = \"<span style='color:green; font-weight:bold;'>【低リスク】</span>\"\n","        recommendation = \"現在の胃がんリスクは低いです。国が推奨する50歳からの対策型検診まで、基本的な生活習慣を維持しましょう。\"\n","        todo = \"次回の定期健康診断の受診\"\n","\n","    html_content = f\"\"\"\n","    <div style=\"border:1px solid #ddd; border-radius:10px; padding:20px; max-width:500px; font-family:sans-serif;\">\n","        <h3 style=\"color:#2c3e50; border-bottom:2px solid #3498db; padding-bottom:5px;\">次世代胃がん検診DX - 個別化ダッシュボード</h3>\n","        <p><b>対象者ID:</b> {int(user['user_id'])} (年齢: {int(user['age'])}歳)</p>\n","        <p><b>あなたのAIリスクスコア:</b> <span style='font-size:24px;'>{user['risk_score']:.1f}</span>/100 {risk_level}</p>\n","        <div style=\"background-color:#f9f9f9; padding:15px; border-left:4px solid #3498db; margin:15px 0;\">\n","            <h4 style=\"margin-top:0;\">💡 AIからの推奨事項（ナッジ）</h4>\n","            <p>{recommendation}</p>\n","        </div>\n","        <div>\n","            <h4 style=\"color:#e67e22;\">✅ 次のアクション (To-Do)</h4>\n","            <label><input type=\"checkbox\"> {todo}</label>\n","        </div>\n","    </div>\n","    \"\"\"\n","    display(HTML(html_content))\n","\n","\n","# ==============================================================================\n","# Step 4: 企業・健保向け「精度管理ダッシュボード」の構築\n","# ==============================================================================\n","def display_enterprise_dashboard():\n","    \"\"\"企業の人事労務・健保担当者向けのプロセス指標とカプランマイヤー曲線の可視化\"\"\"\n","    print(\"\\n\" + \"=\"*60)\n","    print(\"企業・健保向け 精度管理ダッシュボード (SaaS管理画面)\")\n","    print(\"=\"*60)\n","\n","    # 1. プロセス指標の計算\n","    total_eligible = len(df[df['age'] >= 50]) # 50歳以上（国の指針ベース）\n","    total_screened = len(df) # 職域なので全員何らかの健診は受けたと仮定\n","    n_requires_sec = df['requires_secondary'].sum()\n","    n_sec_done = df['secondary_done'].sum()\n","\n","    sec_rate = (n_requires_sec / len(df)) * 100\n","    sec_done_rate = (n_sec_done / n_requires_sec) * 100\n","\n","    print(f\"【全体プロセス指標（KPI）】\")\n","    print(f\"  - 健診受診者総数 : {total_screened:,} 人\")\n","    print(f\"  - 要精検者数     : {n_requires_sec:,} 人 (要精検率: {sec_rate:.1f}%)\")\n","    print(f\"  - 精検受診者数   : {n_sec_done:,} 人\")\n","    print(f\"  - 精検受診率     : {sec_done_rate:.1f}% (※国の目標値は90%)\")\n","    if sec_done_rate < 90:\n","        print(\"  ⚠️ 警告: 精検受診率が国の目標(90%)を下回っています。フォローアップ介入が必要です。\")\n","\n","    # 2. 生存時間解析 (Kaplan-Meier) によるリコール（再勧奨）最適化\n","    plt.figure(figsize=(10, 6))\n","    kmf = KaplanMeierFitter()\n","\n","    # 全体の要精検者データ\n","    T = df[df['requires_secondary'] == 1]['days_to_secondary']\n","    E = df[df['requires_secondary'] == 1]['secondary_done']\n","\n","    # 「除菌歴あり(若年層に多い)」と「除菌歴なし」でグループ分けして解析\n","    groups = df[df['requires_secondary'] == 1]['hp_eradicated']\n","\n","    ax = plt.subplot(111)\n","\n","    # ピロリ除菌歴「なし」グループ\n","    idx_no_hp = (groups == 0)\n","    kmf.fit(T[idx_no_hp], event_observed=E[idx_no_hp], label='ピロリ除菌歴 なし (未感染含む)')\n","    kmf.plot_survival_function(ax=ax, color='blue')\n","\n","    # ピロリ除菌歴「あり」グループ\n","    idx_hp = (groups == 1)\n","    kmf.fit(T[idx_hp], event_observed=E[idx_hp], label='ピロリ除菌歴 あり (過信しがちな層)')\n","    kmf.plot_survival_function(ax=ax, color='red', linestyle='--')\n","\n","    plt.title('【精度管理】要精検判定後の未受診率の推移 (Kaplan-Meier曲線)\\n〜 除菌歴による受診行動の乖離 〜')\n","    plt.xlabel('要精検判定からの経過日数')\n","    plt.ylabel('未受診率 (1.0 = 全員未受診)')\n","    plt.axhline(y=0.1, color='gray', linestyle=':', label='国の目標ライン (未受診率10%以下)')\n","    plt.grid(True, alpha=0.3)\n","    plt.legend()\n","    plt.show()\n","\n","    print(\"\\n【データサイエンスによるインサイト】\")\n","    print(\"カプランマイヤー曲線から、「ピロリ除菌歴あり」のグループ（赤破線）は、\")\n","    print(\"「除菌したからもう胃がんにはならない」というバイアスが働き、受診が遅れ、\")\n","    print(\"最終的な未受診率も高いことが分かります。\")\n","    print(\"→ アクション: この層に対し、判定後30日の段階で「除菌後も胃がんリスクは残る」\")\n","    print(\"  という教育コンテンツ付きの自動リコール（ナッジ）を配信するよう設定します。\")\n","\n","# ==============================================================================\n","# メイン実行ブロック\n","# ==============================================================================\n","if __name__ == \"__main__\":\n","    # Step 3のデモ: ピロリ除菌済みで年齢が若い対象者（放置リスクが高い）のUIを表示\n","    target_user = df[(df['hp_eradicated'] == 1) & (df['age'] < 50) & (df['requires_secondary'] == 1)].iloc[0]\n","    display_patient_app(target_user['user_id'])\n","\n","    # Step 4のデモ: 管理者ダッシュボードを表示\n","    display_enterprise_dashboard()"],"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","    <div style=\"border:1px solid #ddd; border-radius:10px; padding:20px; max-width:500px; font-family:sans-serif;\">\n","        <h3 style=\"color:#2c3e50; border-bottom:2px solid #3498db; padding-bottom:5px;\">次世代胃がん検診DX - 個別化ダッシュボード</h3>\n","        <p><b>対象者ID:</b> 4 (年齢: 32歳)</p>\n","        <p><b>あなたのAIリスクスコア:</b> <span style='font-size:24px;'>45.2</span>/100 <span style='color:orange; font-weight:bold;'>【中リスク】</span></p>\n","        <div style=\"background-color:#f9f9f9; padding:15px; border-left:4px solid #3498db; margin:15px 0;\">\n","            <h4 style=\"margin-top:0;\">💡 AIからの推奨事項（ナッジ）</h4>\n","            <p>定期的なモニタリングが必要です。今年はABC検診（血液検査）または胃部X線検査を受診してください。</p>\n","        </div>\n","        <div>\n","            <h4 style=\"color:#e67e22;\">✅ 次のアクショ